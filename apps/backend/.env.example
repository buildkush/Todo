# Database - Supabase PostgreSQL connection string
# Use the value from Supabase > Project settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Server
PORT=5000
NODE_ENV=production

# Frontend URL used for CORS and auth redirects
# Example: https://your-app.netlify.app
FRONTEND_URL="https://your-frontend-url.netlify.app"

# Authentication secrets
# Must be a strong random string in production; never expose this in the frontend
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Logging
LOG_LEVEL="info"
