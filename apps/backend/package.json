{
  "name": "@todo/backend",
  "version": "1.0.0",
  "description": "Todo App - Express backend with Prisma ORM",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run prisma:migrate && nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "npm run prisma:migrate && node dist/index.js",
    "prisma:gen": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Linting...'",
    "test": "echo 'Testing...'"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "nodemon": "^3.0.2",
    "prisma": "^5.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
